{
  "title": "Aegis",
  "uid": "aegis",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Events Ingested (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "aegis-prom" },
      "targets": [
        {
          "expr": "rate(aegis_events_ingested_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Incidents Processed (total)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "aegis-prom" },
      "targets": [
        {
          "expr": "aegis_incidents_processed_total",
          "refId": "A"
        }
      ]
    }
  ]
}
